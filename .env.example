# Papalinguas — variáveis de ambiente (Manual Técnico 12.1)
# Sem as variáveis do Supabase o app roda em MODO DEMONSTRAÇÃO (dados locais, sem cobrança, sem IA real).
# Nunca coloque valores reais neste arquivo; use .env.local (ignorado pelo git) e as variáveis da Vercel.

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (banco, login, arquivos)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Voz e IA (OpenAI)
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime-2.1-mini
OPENAI_TEXT_MODEL=

# Pronúncia (Azure Speech) — região próxima do Brasil, ex.: brazilsouth
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# Pagamentos e NFS-e (Asaas): sandbox | production
ASAAS_API_KEY=
ASAAS_ENV=sandbox
ASAAS_WEBHOOK_TOKEN=

# Fase 2
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# E-mail e push
RESEND_API_KEY=
EMAIL_FROM=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Observabilidade e marketing (pixels só com consentimento de cookies)
SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
META_PIXEL_ID=
GOOGLE_ADS_ID=
GA4_ID=

# Segurança
ADMIN_ALLOWED_IPS=
CRON_SECRET=

# Painel admin: administrador inicial (Super Admin). A senha NUNCA vai em texto:
# gere o hash com `npm run admin:hash` e cole aqui.
ADMIN_USERNAME=Admin
ADMIN_PASSWORD_HASH=
# Segredo da sessão do painel (mín. 32 caracteres): openssl rand -base64 48
ADMIN_SESSION_SECRET=
# Chave mestra do cofre de chaves de integração (32 bytes em base64): openssl rand -base64 32
KEYS_ENCRYPTION_KEY=

# Backup de texto (opcional; preferir cadastrar no painel em Chaves de integração)
ANTHROPIC_API_KEY=
ANTHROPIC_TEXT_MODEL=claude-opus-5-5

# Site institucional (SEO, canônico, sitemap)
NEXT_PUBLIC_SITE_URL=https://papalinguas.com.br
